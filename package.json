{
  "name": "airlink-studio",
  "version": "1.0.0",
  "description": "An open-source Android and Windows device connectivity platform with wireless screen mirroring, remote control and file transfer.",
  "main": "dist-electron/main/index.js",
  "homepage": "https://github.com/luckydx109/airlink-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/luckydx109/airlink-studio.git"
  },
  "bugs": {
    "url": "https://github.com/luckydx109/airlink-studio/issues"
  },
  "author": "Lucky Vishwakarma",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/setup-binaries.js",
    "postinstall": "node scripts/setup-binaries.js",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --dir",
    "build:win": "tsc && vite build && electron-builder --win",
    "preview": "vite preview"
  },
  "keywords": [
    "android",
    "windows",
    "screen-mirroring",
    "remote-control",
    "scrcpy",
    "adb",
    "wireless",
    "file-transfer",
    "electron",
    "open-source"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
